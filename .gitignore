# Dependencies
node_modules/

# Build outputs
dist/

# Turbo cache
.turbo/

# Test coverage
coverage/

# Environment files
.env
.env.*
!.env.example

# OS artifacts
.DS_Store
Thumbs.db

# Editor artifacts
.vscode/
.idea/
*.swp
*.swo

# npm lockfile (pnpm is the intended package manager)
package-lock.json

# tsup temp bundled config artifacts
**/tsup.config.bundled_*

# TypeScript incremental build cache
*.tsbuildinfo
**/_tmp_*

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Changesets (keep the folder, ignore stale files)
.changeset/*.md
!.changeset/config.json
!.changeset/README.md

# pnpm local store (created in sandboxed environments)
.pnpm-store/

# Generated Prisma test client and SQLite test database
packages/prisma/src/tests/generated/
packages/prisma/src/tests/*.db
packages/prisma/src/tests/*.db-journal
